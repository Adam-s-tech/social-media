# Environment Variables — Social Media AI
# Copy this file to .env and fill in your API keys.
# Never commit the .env file to Git.
#
# FR: Copiez ce fichier en .env et remplissez vos clés API.
# Ne commitez jamais le fichier .env dans Git.
#
# Guide: docs/API_KEYS.md

# -------------------------------------------------------------------
# Apify — Instagram scraping
# Get your key: https://console.apify.com → Settings → API & Integrations
# FR: Clé pour le scraping des Reels Instagram via Apify
# -------------------------------------------------------------------
APIFY_API_TOKEN=

# -------------------------------------------------------------------
# Google Gemini — AI video analysis
# Get your key: https://aistudio.google.com → Get API key
# FR: Clé pour l'analyse vidéo multimodale via Google Gemini 2.0 Flash
# -------------------------------------------------------------------
GEMINI_API_KEY=

# -------------------------------------------------------------------
# Anthropic — AI concept generation
# Get your key: https://console.anthropic.com → API Keys
# FR: Clé pour la génération de concepts vidéo via Claude Sonnet
# -------------------------------------------------------------------
ANTHROPIC_API_KEY=
